{
  "name": "dsh-cost-pill",
  "version": "0.1.0",
  "description": "DeepSeek Harness session cost pill: official CNY prices with peak/off-peak billing in the composer dock, click for the token breakdown.",
  "license": "MIT",
  "author": "debug-null",
  "type": "module",
  "homepage": "https://github.com/debug-null/dsh-cost-pill#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/debug-null/dsh-cost-pill.git"
  },
  "bugs": {
    "url": "https://github.com/debug-null/dsh-cost-pill/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "cost",
    "usage",
    "billing",
    "tokens",
    "cny"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
